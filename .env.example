# Copy this file to .env and fill in real values.

# ---- GROQ (LLM provider for Phase 0/1) ----
# Only these three are read by src/config/settings.py and enforced by the
# startup config check.
GROQ_API_KEY=gsk_your_groq_api_key_here          # required -- no default, app fails fast at startup if unset
GROQ_API_URL=https://api.groq.com/openai/v1       # optional -- safe default
GROQ_MODEL=llama-3.3-70b-versatile                # optional -- safe default, override per environment

# ---- App ----
APP_ENV=development                                # development | production

# ---- Reserved for later phases (NOT read by Phase 0/1 code) ----
ANTHROPIC_API_KEY=sk-ant-your-key-here             # Phase 4+ alt provider
OPENAI_API_KEY=sk-your-key-here                    # Phase 4+ alt provider
DATABASE_URL=postgresql://user:password@localhost:5432/triage_agent   # Phase 2+ Postgres reviewer store
ARIZE_API_KEY=your-arize-key-here                  # Phase 4+ eval/monitoring
ARIZE_SPACE_KEY=your-arize-space-key-here          # Phase 4+ eval/monitoring
