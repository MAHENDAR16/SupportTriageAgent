# Copy this file to .env and fill in real values.

# ---- GROQ (LLM provider for Phase 0/1) ----
# Only these three are read by src/config/settings.py and enforced by the
# startup config check.
GROQ_API_KEY=gsk_your_groq_api_key_here          # required -- no default, app fails fast at startup if unset
GROQ_API_URL=https://api.groq.com/openai/v1       # optional -- safe default
GROQ_MODEL=llama-3.3-70b-versatile                # optional -- safe default, override per environment

# ---- App ----
APP_ENV=development                                # development | production

# ---- Arize AI (optional LLM tracing) ----
# Set both ARIZE_API_KEY and ARIZE_SPACE_ID (from your Arize account's "Upload
# Data" page) to send LangChain/LangGraph LLM traces to Arize. Leave either
# blank to disable -- the app runs unaffected either way.
ARIZE_API_KEY=                                      # optional -- leave blank to disable Arize tracing
ARIZE_SPACE_ID=                                      # optional -- required alongside ARIZE_API_KEY to enable
ARIZE_PROJECT_NAME=support-triage-agent              # optional -- project name shown in the Arize UI
